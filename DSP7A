clc;
clear;
close all;

%% Sampling and Time
fs = 1000;
t = (0:999)/fs;

%% Original Signal
s = sin(2*pi*100*t) + 0.5*sin(2*pi*200*t);

%% Add Gaussian Noise
n = 0.3*randn(size(t));
x = s + n;

%% Figure 1: Signal with Noise
figure;
plot(t, x, 'LineWidth', 1.2);
grid on;
xlabel('Time (s)');
ylabel('Amplitude');
title('Signal with Noise');

%% Figure 2: PSD using Periodogram
figure;
periodogram(x, [], [], fs);
title('PSD using Periodogram');

%% Figure 3: Magnitude Spectrum
N = length(x);
X = abs(fft(x))/N;
f = (0:N-1)*(fs/N);

figure;
plot(f(1:N/2), X(1:N/2), 'LineWidth', 1.2);
grid on;
xlabel('Frequency (Hz)');
ylabel('Magnitude');
title('Magnitude Spectrum');
xlim([0 fs/2]);

%% Figure 4: Power Comparison
signal_power = mean(s.^2);
noise_power = var(n);

figure;
bar([signal_power noise_power]);

set(gca, 'XTick', 1:2);
set(gca, 'XTickLabel', {'Signal', 'Noise'});

ylabel('Power');
title('Power Comparison');
grid on;
