clc;
clear;
close all;

%% Signal
fs = 1000;
N = 256;
t = (0:N-1)/fs;

x = sin(2*pi*100*t) + 0.8*sin(2*pi*110*t);

%% FFT Parameters
NFFT = 2048;
f = (0:NFFT/2-1)*(fs/NFFT);

%% Windows
w = {rectwin(N), hamming(N), hann(N)};
names = {'Rectangular', 'Hamming', 'Hanning'};

%% Processing
for i = 1:3
    
    % Apply window
    xw = x(:) .* w{i};
    
    % FFT
    X = fft(xw, NFFT);
    
    % Magnitude spectrum
    P{i} = abs(X(1:NFFT/2));
    
    % Normalize
    P{i} = P{i} / max(P{i});
end

%% Individual Spectrums
figure;

for i = 1:3
    
    subplot(3,1,i);
    
    plot(f, 20*log10(P{i} + eps), 'LineWidth', 1.5);
    
    grid on;
    xlabel('Frequency (Hz)');
    ylabel('Magnitude (dB)');
    title(['Spectrum using ' names{i} ' Window']);
    
    xlim([0 250]);
    ylim([-80 5]);
end

%% Combined Spectrum Comparison
figure;

plot(f, 20*log10(P{1} + eps), 'LineWidth', 1.5);
hold on;

plot(f, 20*log10(P{2} + eps), 'LineWidth', 1.5);

plot(f, 20*log10(P{3} + eps), 'LineWidth', 1.5);

grid on;

xlabel('Frequency (Hz)');
ylabel('Magnitude (dB)');
title('Windowing Technique Comparison');

legend('Rectangular', 'Hamming', 'Hanning');

xlim([50 160]);
ylim([-80 5]);
