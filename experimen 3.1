clc;
clear;
close all;

% 1. Specifications
Fs = 2000;       % Sampling Frequency
Rp = 1;          % Passband Ripple (dB)
Rs = 40;         % Stopband Attenuation (dB)

Wp = [300 600] / (Fs/2);   % Passband frequencies
Ws = [200 700] / (Fs/2);   % Stopband frequencies

% 2. Butterworth Bandpass Filter
[n1, W1] = buttord(Wp, Ws, Rp, Rs);
[b1, a1] = butter(n1, W1, 'bandpass');

% 3. Chebyshev Type-I Bandpass Filter
[n2, W2] = cheb1ord(Wp, Ws, Rp, Rs);
[b2, a2] = cheby1(n2, Rp, W2, 'bandpass');

% 4. Display Filter Orders
fprintf('Butterworth Order = %d\n', n1);
fprintf('Chebyshev Type-I Order = %d\n', n2);

% 5. Magnitude / Frequency Response
figure;
freqz(b1, a1);
title('Butterworth Filter - Frequency Response');

figure;
freqz(b2, a2);
title('Chebyshev Type-I Filter - Frequency Response');

% 6. Group Delay
figure;
grpdelay(b1, a1);
hold on;
grpdelay(b2, a2);
legend('Butterworth', 'Chebyshev-I');
title('Group Delay Comparison');

% 7. Pole-Zero Plot
figure;
subplot(1,2,1);
zplane(b1, a1);
title('Butterworth Pole-Zero');

subplot(1,2,2);
zplane(b2, a2);
title('Chebyshev-I Pole-Zero');

% 8. Impulse Response
figure;
subplot(2,1,1);
impz(b1, a1);
title('Butterworth Impulse Response');

subplot(2,1,2);
impz(b2, a2);
title('Chebyshev-I Impulse Response');

% 9. Pole Magnitude
figure;
subplot(1,2,1);
stem(abs(roots(a1)), 'filled');
title('Butterworth Pole Magnitude');
xlabel('Pole Number');
ylabel('Magnitude');

subplot(1,2,2);
stem(abs(roots(a2)), 'filled');
title('Chebyshev-I Pole Magnitude');
xlabel('Pole Number');
ylabel('Magnitude');
